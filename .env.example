DATABASE_URL=mysql://user:password@host:3306/nourish_net_db
# Or provide these separately:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nourish_net_db
DB_CONNECTION_LIMIT=3
VITE_API_BASE_URL=/api
CORS_ORIGIN=http://localhost:3000
DATABASE_SSL=false
DB_MAX_IDLE=3
DB_IDLE_TIMEOUT=60000
DB_QUEUE_LIMIT=0

# Optional local Ollama integration. Keep disabled in production unless the
# server can reach a protected Ollama instance.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
